# ============================================================
# Template A: Tarot / LINE shared env (.env.openai / .env.gemini / .env.openrouter)
# ============================================================

# --- App / Telegram ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
SUPPORT_EMAIL=support@yourdomain.com
# CHARACTER=tarot
# THROTTLE_MESSAGE_INTERVAL_SEC=1.2
# THROTTLE_CALLBACK_INTERVAL_SEC=0.8

# --- Database ---
# SQLITE_DB_PATH=./var/telegram-tarot-bot.db

# --- Monetization ---
# PAYWALL_ENABLED=false
# ONE_MESSAGE_TOKENS=600
# TRIAL_FREE_CREDITS=10
# PASS_7D_DAILY_LIMIT=25
# PASS_30D_DAILY_LIMIT=30

# --- LLM ---
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_MODEL=gemini-2.5-flash
# OpenRouter connection test only:
# OPENAI_MODEL=openrouter/auto
# OpenRouter recommended fixed model for Tarot / LINE:
# OPENAI_MODEL=nousresearch/hermes-3-llama-3.1-70b

# --- LINE Prince ---
# LINE_CHANNEL_SECRET=your_line_channel_secret
# LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
# LINE_ADMIN_USER_IDS=admin_line_user_id1,admin_line_user_id2
# LINE_FREE_MESSAGES_PER_MONTH=30
# LINE_VERIFY_SIGNATURE=true
# PRINCE_SYSTEM_PROMPT=custom_prince_persona_prompt
# LINE_OPENAI_MODEL=gpt-4o-mini


# ============================================================
# Template B: Arisa dedicated env (.env.arisa.openai / .env.arisa.gemini / .env.arisa.openrouter)
# ============================================================

# --- App / Telegram ---
# TELEGRAM_BOT_TOKEN=your_arisa_telegram_bot_token
# SUPPORT_EMAIL=support@yourdomain.com
# CHARACTER=arisa
# ADMIN_USER_IDS=123456789,987654321
# THROTTLE_MESSAGE_INTERVAL_SEC=1.2
# THROTTLE_CALLBACK_INTERVAL_SEC=0.8

# --- Database ---
# SQLITE_DB_PATH=./var/telegram-arisa-bot.db

# --- Monetization ---
# PAYWALL_ENABLED=true
# ONE_MESSAGE_TOKENS=600
# TRIAL_FREE_CREDITS=10
# PASS_7D_DAILY_LIMIT=25
# PASS_30D_DAILY_LIMIT=30

# --- LLM ---
# OPENAI_API_KEY=your_openai_api_key
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_MODEL=gemini-2.5-flash
# OpenRouter connection test only:
# OPENAI_MODEL=openrouter/auto
# OpenRouter recommended fixed model for Arisa:
# OPENAI_MODEL=sao10k/l3.1-euryale-70b

# --- LINE Prince ---
# (unused in Arisa Telegram mode)
